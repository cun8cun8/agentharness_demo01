# Runtime
RESEARCHFORGE_API_KEY_FILE=
RESEARCHFORGE_METRICS_TOKEN_FILE=
RESEARCHFORGE_API_HOST_PORT=8001
RESEARCHFORGE_NETWORK_ENABLED=0
RESEARCHFORGE_SANDBOX_BACKEND=local
RESEARCHFORGE_SANDBOX_IMAGE=python:3.12-slim
RESEARCHFORGE_REPOSITORY_CACHE_ROOT=/var/lib/researchforge/workspaces/repositories
RESEARCHFORGE_SANDBOX_SHARED_WORKSPACE_ROOT=/var/lib/researchforge/workspaces
RESEARCHFORGE_SANDBOX_KUBERNETES_NAMESPACE=default
RESEARCHFORGE_SANDBOX_KUBERNETES_KUBECONFIG=
RESEARCHFORGE_SANDBOX_KUBERNETES_SERVICE_ACCOUNT=
RESEARCHFORGE_SANDBOX_KUBERNETES_WORKSPACE_PVC=
RESEARCHFORGE_SANDBOX_KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
RESEARCHFORGE_SANDBOX_KUBERNETES_ACTIVE_DEADLINE_SECONDS=600
RESEARCHFORGE_SANDBOX_KUBERNETES_KEEP_PODS=0
RESEARCHFORGE_SANDBOX_KUBERNETES_RUNTIME_CLASS=
RESEARCHFORGE_SANDBOX_KUBERNETES_EGRESS_RULES=[]

# Redis Job queue is required for API/Worker deployment. The event bus is
# independent: Redis is the local default; Kafka/Redpanda is only needed for
# the full event-streaming profile.
RESEARCHFORGE_JOB_QUEUE_BACKEND=redis
RESEARCHFORGE_JOB_QUEUE_NAME=researchforge:jobs
RESEARCHFORGE_JOB_WORKER_ENABLED=0
RESEARCHFORGE_JOB_DELIVERY_MODE=stream
RESEARCHFORGE_JOB_VISIBILITY_TIMEOUT_SECONDS=900
RESEARCHFORGE_JOB_MAX_RETRIES=2
RESEARCHFORGE_WORKFLOW_BACKEND=queue
RESEARCHFORGE_TEMPORAL_ADDRESS=127.0.0.1:7233
RESEARCHFORGE_TEMPORAL_NAMESPACE=default
RESEARCHFORGE_TEMPORAL_TASK_QUEUE=researchforge-workflows

# Optional event bus
RESEARCHFORGE_EVENT_BUS_BACKEND=redis
RESEARCHFORGE_EVENT_BUS_URL=redis://redis:6379/0
RESEARCHFORGE_EVENT_BUS_CHANNEL=researchforge:events
# For Redpanda/Kafka:
# RESEARCHFORGE_EVENT_BUS_BACKEND=kafka
# RESEARCHFORGE_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# RESEARCHFORGE_KAFKA_TOPIC=researchforge.events

# GitHub OAuth
RESEARCHFORGE_GITHUB_CLIENT_ID=
RESEARCHFORGE_GITHUB_CLIENT_SECRET=
RESEARCHFORGE_GITHUB_OAUTH_STATE_SECRET=
RESEARCHFORGE_GITHUB_REDIRECT_URI=http://127.0.0.1:3010/
RESEARCHFORGE_GITHUB_SCOPES=read:user user:email
# Signed GitHub Issue automation. Leave the secret out of version control.
RESEARCHFORGE_GITHUB_WEBHOOK_SECRET=
RESEARCHFORGE_GITHUB_WEBHOOK_PUBLIC_URL=
RESEARCHFORGE_GITHUB_ISSUE_TRIGGER_LABEL=researchforge

# Model gateway
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
RESEARCHFORGE_MODEL_NAME=
RESEARCHFORGE_RESEARCH_MODEL_NAME=
# OpenAI-compatible client accepts OpenAI, Qwen, DashScope, LiteLLM and vLLM.
# Set this to a LiteLLM/vLLM endpoint when using a shared model gateway.
RESEARCHFORGE_MODEL_BASE_URL=
RESEARCHFORGE_AGENT_BACKEND=langgraph
