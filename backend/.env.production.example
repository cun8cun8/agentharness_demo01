# Production configuration skeleton. Keep this file secret-free.
# Supply credential values through your deployment secret manager, not this file.

# Core runtime and access control
RESEARCHFORGE_ENV=production
RESEARCHFORGE_API_HOST=0.0.0.0
RESEARCHFORGE_API_PORT=8001
RESEARCHFORGE_AUTH_MODE=production
RESEARCHFORGE_API_KEY_ENV=RESEARCHFORGE_API_KEY
RESEARCHFORGE_CORS_ORIGINS=https://researchforge.example.com
RESEARCHFORGE_RATE_LIMIT_PER_MINUTE=120
RESEARCHFORGE_AUTH_RATE_LIMIT_PER_MINUTE=30
RESEARCHFORGE_RATE_LIMIT_BACKEND=redis
RESEARCHFORGE_MAX_REQUEST_BODY_BYTES=5000000

# Persistence, queue, events, and artifacts
RESEARCHFORGE_PERSISTENCE=1
RESEARCHFORGE_STORE_BACKEND=postgres
RESEARCHFORGE_POSTGRES_DSN=postgresql://REPLACE_WITH_RUNTIME_IDENTITY@postgres.example.internal:5432/researchforge
RESEARCHFORGE_JOB_QUEUE_BACKEND=redis
RESEARCHFORGE_JOB_DELIVERY_MODE=stream
RESEARCHFORGE_JOB_WORKER_ENABLED=0
RESEARCHFORGE_REDIS_URL=rediss://REPLACE_WITH_RUNTIME_IDENTITY@redis.example.internal:6379/0
RESEARCHFORGE_EVENT_BUS_BACKEND=kafka
RESEARCHFORGE_EVENT_BUS_URL=REPLACE_WITH_RUNTIME_IDENTITY
RESEARCHFORGE_KAFKA_BOOTSTRAP_SERVERS=kafka.example.internal:9093
RESEARCHFORGE_KAFKA_TOPIC=researchforge.events
RESEARCHFORGE_ARTIFACT_STORE_BACKEND=s3
RESEARCHFORGE_ARTIFACT_STORE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
RESEARCHFORGE_ARTIFACT_STORE_PREFIX=artifacts
RESEARCHFORGE_ARTIFACT_STORE_REGION=REPLACE_WITH_REGION
RESEARCHFORGE_ARTIFACT_STORE_AUTO_CREATE_BUCKET=0

# Agent and sandbox security
RESEARCHFORGE_ALLOW_MOCK_MODELS=0
RESEARCHFORGE_STRICT_BENCHMARKS=1
RESEARCHFORGE_NETWORK_ENABLED=1
RESEARCHFORGE_SANDBOX_NETWORK_ENABLED=0
RESEARCHFORGE_SANDBOX_BACKEND=kubernetes
RESEARCHFORGE_SANDBOX_IMAGE=REPLACE_WITH_SANDBOX_IMAGE
RESEARCHFORGE_SANDBOX_KUBERNETES_NAMESPACE=researchforge-sandbox
RESEARCHFORGE_SANDBOX_KUBERNETES_SERVICE_ACCOUNT=researchforge-sandbox
RESEARCHFORGE_SANDBOX_KUBERNETES_WORKSPACE_PVC=researchforge-workspaces
RESEARCHFORGE_SANDBOX_SHARED_WORKSPACE_ROOT=/workspaces
RESEARCHFORGE_SANDBOX_MEMORY_LIMIT=512m
RESEARCHFORGE_SANDBOX_CPU_LIMIT=1.0
RESEARCHFORGE_SANDBOX_PIDS_LIMIT=256
RESEARCHFORGE_SANDBOX_MAX_CONCURRENT=8
RESEARCHFORGE_SANDBOX_QUEUE_TIMEOUT_SECONDS=30

# Real model gateway. The key environment variable is injected by the runtime.
RESEARCHFORGE_MODEL_BASE_URL=https://REPLACE_WITH_MODEL_GATEWAY/v1
RESEARCHFORGE_MODEL_PROVIDER=openai_compatible
RESEARCHFORGE_MODEL_API_KEY_ENV=RESEARCHFORGE_MODEL_API_KEY
RESEARCHFORGE_MODEL_NAME=REPLACE_WITH_CODING_MODEL
RESEARCHFORGE_RESEARCH_MODEL_NAME=REPLACE_WITH_RESEARCH_MODEL
# Optional multi-model catalog. Values are JSON and must contain model_name.
# Example for Qwen:
# RESEARCHFORGE_MODEL_CATALOG=[{"id":"qwen_coding","provider":"qwen","model_name":"qwen-plus","role":"coding","api_key_env":"DASHSCOPE_API_KEY","strategy_ids":["repair_baseline_v1","repair_with_trace_v2","repair_with_critic_v3"]}]
RESEARCHFORGE_MODEL_CATALOG=[]
RESEARCHFORGE_MODEL_CONTEXT_WINDOW=128000
RESEARCHFORGE_MODEL_COST_PER_1K_TOKENS=0.002
RESEARCHFORGE_MODEL_TIMEOUT_SECONDS=20
RESEARCHFORGE_MODEL_MAX_RETRIES=2
# Prefer a mature open-source runtime. Resolution order is OpenHands,
# mini-SWE-agent, then the LangGraph adapter. Native is offline compatibility
# mode only and must be selected explicitly.
RESEARCHFORGE_AGENT_BACKEND=auto
# Build backend/Dockerfile.agent-runtime and use its immutable tag as the
# sandbox image when mini-SWE-agent is selected.
RESEARCHFORGE_AGENT_COMMAND=
RESEARCHFORGE_AGENT_MODEL_MODE=gateway
# The Bridge is an OpenAI-compatible endpoint. Its token must be provided by
# the secret manager under the referenced environment variable.
RESEARCHFORGE_AGENT_BRIDGE_URL=https://researchforge-api.example.internal/api/v1/models/bridge
RESEARCHFORGE_AGENT_BRIDGE_TOKEN_ENV=RESEARCHFORGE_AGENT_BRIDGE_TOKEN
RESEARCHFORGE_AGENT_TIMEOUT_SECONDS=900
RESEARCHFORGE_AGENT_OUTPUT_LIMIT_BYTES=128000
# A delegated task receives an equal-or-smaller budget and cannot recurse beyond this depth.
RESEARCHFORGE_AGENT_MAX_DELEGATION_DEPTH=2

# Optional knowledge and observability services
RESEARCHFORGE_KNOWLEDGE_BACKEND=pgvector
RESEARCHFORGE_EMBEDDING_BASE_URL=https://REPLACE_WITH_EMBEDDING_GATEWAY/v1
RESEARCHFORGE_EMBEDDING_MODEL=REPLACE_WITH_EMBEDDING_MODEL
RESEARCHFORGE_EMBEDDING_API_KEY_ENV=RESEARCHFORGE_EMBEDDING_API_KEY
RESEARCHFORGE_NEO4J_URI=neo4j+s://neo4j.example.internal
RESEARCHFORGE_NEO4J_USER=neo4j
RESEARCHFORGE_NEO4J_PASSWORD_ENV=RESEARCHFORGE_NEO4J_PASSWORD
RESEARCHFORGE_OTEL_ENABLED=1
RESEARCHFORGE_OTEL_ENDPOINT=https://otel-collector.example.internal/v1/traces
RESEARCHFORGE_METRICS_TOKEN_ENV=RESEARCHFORGE_METRICS_TOKEN

# GitHub and enterprise identity. All secret values use environment references.
RESEARCHFORGE_GITHUB_APP_ID=REPLACE_WITH_GITHUB_APP_ID
RESEARCHFORGE_GITHUB_APP_PRIVATE_KEY_ENV=RESEARCHFORGE_GITHUB_APP_PRIVATE_KEY
RESEARCHFORGE_GITHUB_WEBHOOK_SECRET_ENV=RESEARCHFORGE_GITHUB_WEBHOOK_SECRET
RESEARCHFORGE_GITHUB_WEBHOOK_PUBLIC_URL=https://researchforge.example.com/api/v1/integrations/github/webhook
RESEARCHFORGE_GITHUB_ISSUE_TRIGGER_LABEL=researchforge
RESEARCHFORGE_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
RESEARCHFORGE_GITHUB_CLIENT_SECRET_ENV=RESEARCHFORGE_GITHUB_CLIENT_SECRET
RESEARCHFORGE_GITHUB_STATE_SECRET_ENV=RESEARCHFORGE_GITHUB_OAUTH_STATE_SECRET
RESEARCHFORGE_GITHUB_REDIRECT_URI=https://researchforge.example.com/
RESEARCHFORGE_SCIM_BEARER_TOKEN_ENV=RESEARCHFORGE_SCIM_BEARER_TOKEN
RESEARCHFORGE_SCIM_DEFAULT_WORKSPACE_ID=workspace_default
RESEARCHFORGE_SCIM_ALLOWED_WORKSPACE_IDS=workspace_default

# Kubernetes training is optional. Enable only after GPU and RWX PVC validation.
RESEARCHFORGE_TRAINING_BACKEND=kubernetes
RESEARCHFORGE_TRAINING_IMAGE=REPLACE_WITH_TRAINER_IMAGE
RESEARCHFORGE_TRAINING_KUBERNETES_NAMESPACE=researchforge-training
RESEARCHFORGE_TRAINING_KUBERNETES_SERVICE_ACCOUNT=researchforge-training
RESEARCHFORGE_TRAINING_KUBERNETES_WORKSPACE_PVC=researchforge-workspaces
RESEARCHFORGE_TRAINING_KUBERNETES_SHARED_ROOT=/workspaces
