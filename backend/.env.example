RESEARCHFORGE_ENV=local
RESEARCHFORGE_API_HOST=127.0.0.1
RESEARCHFORGE_API_PORT=8001
RESEARCHFORGE_PERSISTENCE=1
RESEARCHFORGE_STORE_BACKEND=json
RESEARCHFORGE_STORE_PATH=.data/store.json
RESEARCHFORGE_POSTGRES_DSN=postgresql://researchforge:researchforge@localhost:5432/researchforge
RESEARCHFORGE_WORKFLOW_BACKEND=queue
RESEARCHFORGE_TEMPORAL_ADDRESS=127.0.0.1:7233
RESEARCHFORGE_TEMPORAL_NAMESPACE=default
RESEARCHFORGE_TEMPORAL_TASK_QUEUE=researchforge-workflows
RESEARCHFORGE_MODEL_TIMEOUT_SECONDS=20
RESEARCHFORGE_MODEL_BASE_URL=
RESEARCHFORGE_MODEL_API_KEY_ENV=OPENAI_API_KEY
# Optional non-USD billing rates to USD, for example {"EUR":1.08,"CNY":0.14}.
# A submitted statement rate takes precedence and is preserved with the reconciliation.
RESEARCHFORGE_BILLING_FX_RATES={}
RESEARCHFORGE_RESEARCH_PROVIDER=local
RESEARCHFORGE_CROSSREF_MAILTO=
RESEARCHFORGE_RESEARCH_TIMEOUT_SECONDS=8
RESEARCHFORGE_SANDBOX_BACKEND=local
RESEARCHFORGE_SANDBOX_IMAGE=python:3.12-slim
RESEARCHFORGE_NETWORK_ENABLED=0
RESEARCHFORGE_SANDBOX_NETWORK_ENABLED=0
RESEARCHFORGE_AGENT_MAX_DELEGATION_DEPTH=2
RESEARCHFORGE_AUTH_MODE=development
RESEARCHFORGE_ALLOW_MOCK_MODELS=1
RESEARCHFORGE_RATE_LIMIT_PER_MINUTE=600
RESEARCHFORGE_MAX_REQUEST_BODY_BYTES=5000000
RESEARCHFORGE_STRICT_BENCHMARKS=0
RESEARCHFORGE_JOB_DELIVERY_MODE=list
RESEARCHFORGE_JOB_VISIBILITY_TIMEOUT_SECONDS=900
RESEARCHFORGE_KNOWLEDGE_BACKEND=local
RESEARCHFORGE_OTEL_ENABLED=0
RESEARCHFORGE_GITHUB_APP_ID=
RESEARCHFORGE_GITHUB_APP_PRIVATE_KEY=
RESEARCHFORGE_GITHUB_APP_TOKEN_REFRESH_SECONDS=300
RESEARCHFORGE_GITHUB_WEBHOOK_SECRET=
RESEARCHFORGE_GITHUB_WEBHOOK_PUBLIC_URL=
RESEARCHFORGE_GITHUB_ISSUE_TRIGGER_LABEL=researchforge
RESEARCHFORGE_ARTIFACT_STORE_SERVER_SIDE_ENCRYPTION=
RESEARCHFORGE_ARTIFACT_STORE_KMS_KEY_ID=
RESEARCHFORGE_ARTIFACT_STORE_WORKSPACE_PREFIX=1
RESEARCHFORGE_SANDBOX_KUBERNETES_RUNTIME_CLASS=
RESEARCHFORGE_SANDBOX_KUBERNETES_EGRESS_RULES=[]
RESEARCHFORGE_SCIM_BEARER_TOKEN=
RESEARCHFORGE_SCIM_DEFAULT_WORKSPACE_ID=workspace_default
RESEARCHFORGE_SCIM_ALLOWED_WORKSPACE_IDS=workspace_default
RESEARCHFORGE_SCIM_GROUPS_ENABLED=1
RESEARCHFORGE_TRAINING_BACKEND=docker
RESEARCHFORGE_TRAINING_IMAGE=researchforge-trainer:local
RESEARCHFORGE_TRAINING_ROOT=.data/training
RESEARCHFORGE_TRAINING_MEMORY=8g
RESEARCHFORGE_TRAINING_CPUS=2
RESEARCHFORGE_TRAINING_GPUS=
RESEARCHFORGE_TRAINING_MAX_CONCURRENT=1
RESEARCHFORGE_TRAINING_POLL_SECONDS=10
RESEARCHFORGE_TRAINING_KUBERNETES_NAMESPACE=default
RESEARCHFORGE_TRAINING_KUBERNETES_WORKSPACE_PVC=
RESEARCHFORGE_TRAINING_KUBERNETES_SHARED_ROOT=
RESEARCHFORGE_TRAINING_KUBERNETES_SERVICE_ACCOUNT=
RESEARCHFORGE_TRAINING_KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
RESEARCHFORGE_TRAINING_KUBERNETES_KEEP_JOBS=0
# node_count > 1 creates a Kubeflow Training Operator PyTorchJob. Each node
# receives gpu_count GPUs and runs world_size processes.
